<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Swipe down on home opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Uninstall from the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only if you turn on contact search in Settings; asked for then, not before. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The Today page's "Coming up" card, only once you tap Show my calendar. Read only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Weather only, and only once you turn it on: rough location to Open-Meteo. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A launcher has to see every app it can launch. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".BitApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bit">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Bit.Home"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pixel lock screen: shown in front of the system lock screen, never instead of it. -->
        <activity
            android:name=".LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="com.hootywhooo86.bitlauncher.lock"
            android:theme="@style/Theme.Bit.Lock" />

        <service
            android:name=".BitNotificationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Double-tap to lock. Turned on by the user in Accessibility settings, off otherwise. -->
        <service
            android:name=".LockService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- Shift mode: a 128bit app (Railtime) can switch between your Home and Work layouts. -->
        <receiver
            android:name=".ShiftReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hootywhooo86.bitlauncher.SET_MODE" />
            </intent-filter>
        </receiver>

        <!-- The current accent and theme colours, read-only, for 128bit apps' widgets to match. -->
        <provider
            android:name=".FamilyThemeProvider"
            android:authorities="com.hootywhooo86.bitlauncher.theme"
            android:exported="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:taskAffinity="" />
    </application>
</manifest>
